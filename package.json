{
  "name": "crewmori-frontend",
  "version": "1.2.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "test:backend": "node --import tsx --test tests/backend-*.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "worker": "node --env-file-if-exists=.env.local --import tsx scripts/worker.ts",
    "backend:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-backend.ts",
    "storage:setup": "node --env-file-if-exists=.env.local --import tsx scripts/setup-storage.ts",
    "test:api": "node scripts/smoke-api.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:ux": "node scripts/test-ux.mjs",
    "verify:build-assets": "node scripts/check-build-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@elevenlabs/client": "1.28.0",
    "@google/genai": "2.30.0",
    "@langchain/langgraph": "1.5.0",
    "@langchain/langgraph-checkpoint-postgres": "1.1.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "lucide-react": "0.577.0",
    "next": "16.4.2",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "23.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.12.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
