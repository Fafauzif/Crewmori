# Copy to .env.local. Leave disabled until the database is migrated and Auth configured.
CREWMORI_BACKEND_ENABLED=false
APP_URL=http://localhost:4173
DATABASE_URL=
DATABASE_POOL_SIZE=5
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
STORAGE_BUCKET=crewmori-private

# All credentials remain server-side. Choose available model IDs explicitly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AGENT_MAX_OUTPUT_TOKENS=1500
AGENT_DAILY_TOKEN_BUDGET=20000
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=
GEMINI_EMBEDDING_DIMENSIONS=768

# Generate 32 random bytes encoded as base64. Do not reuse webhook secrets.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=

# No live-money mode is enabled by this preparation.
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
EXA_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
